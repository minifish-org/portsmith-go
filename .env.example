# Copy to .env and fill in your provider key. Never commit .env.
# Use an OpenAI-compatible Chat Completions endpoint with tool calling.
PORTSMITH_BASE_URL=https://api.deepseek.com/v1
PORTSMITH_MODEL=deepseek-flash
PORTSMITH_API_KEY=

# Optional capacity overrides must stay within the provider's model limits.
# The default uses Pith's pinned model catalog when the model is known.
# PORTSMITH_CONTEXT_WINDOW=1000000
# PORTSMITH_MAX_TOKENS=384000

# Existing OMNI_BASE_URL, OMNI_MODEL and OMNI_API_KEY settings are also accepted.
# PORTSMITH_* values take precedence. --env-file selects an external .env file.
